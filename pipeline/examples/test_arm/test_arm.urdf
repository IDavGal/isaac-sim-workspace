<?xml version="1.0"?>
<robot name="test_arm">
  <link name="base_link">
    <visual><geometry><box size="0.3 0.3 0.2"/></geometry></visual>
    <collision><geometry><box size="0.3 0.3 0.2"/></geometry></collision>
  </link>
  <link name="shoulder">
    <inertial><mass value="2.0"/><inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><geometry><cylinder radius="0.08" length="0.2"/></geometry></visual>
    <collision><geometry><cylinder radius="0.08" length="0.2"/></geometry></collision>
  </link>
  <link name="upper_arm">
    <visual><origin xyz="0 0 0.2"/><geometry><mesh filename="meshes/upper_arm.dae"/></geometry></visual>
    <collision><origin xyz="0 0 0.2"/><geometry><mesh filename="meshes/upper_arm.dae"/></geometry></collision>
  </link>
  <link name="palm">
    <visual><geometry><box size="0.1 0.2 0.05"/></geometry></visual>
    <collision><geometry><box size="0.1 0.2 0.05"/></geometry></collision>
  </link>
  <link name="finger_left">
    <visual><geometry><box size="0.02 0.02 0.08"/></geometry></visual>
    <collision><geometry><box size="0.02 0.02 0.08"/></geometry></collision>
  </link>
  <link name="finger_right">
    <visual><geometry><box size="0.02 0.02 0.08"/></geometry></visual>
    <collision><geometry><box size="0.02 0.02 0.08"/></geometry></collision>
  </link>
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/><child link="shoulder"/>
    <origin xyz="0 0 0.2"/><axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="100" velocity="2"/>
  </joint>
  <joint name="joint_2" type="revolute">
    <parent link="shoulder"/><child link="upper_arm"/>
    <origin xyz="0 0 0.1"/><axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="100" velocity="2"/>
  </joint>
  <joint name="palm_joint" type="fixed">
    <parent link="upper_arm"/><child link="palm"/><origin xyz="0 0 0.45"/>
  </joint>
  <joint name="finger_left_joint" type="prismatic">
    <parent link="palm"/><child link="finger_left"/>
    <origin xyz="0 0.05 0.05"/><axis xyz="0 1 0"/>
    <limit lower="0" upper="0.04" effort="50" velocity="0.2"/>
  </joint>
  <joint name="finger_right_joint" type="prismatic">
    <parent link="palm"/><child link="finger_right"/>
    <origin xyz="0 -0.05 0.05"/><axis xyz="0 1 0"/>
    <limit lower="-0.04" upper="0" effort="50" velocity="0.2"/>
    <mimic joint="finger_left_joint" multiplier="-1" offset="0"/>
  </joint>
</robot>
