#usda 1.0
(
    doc = """Demo scene: a fixed-base two-joint arm on a ground plane.

    joint1 yaws the arm about Z, joint2 pitches the upper link about Y. Both
    have position drives so the arm holds its targets against gravity.
    """
    defaultPrim = "World"
    metersPerUnit = 1
    kilogramsPerUnit = 1
    startTimeCode = 0
    endTimeCode = 1000000
    timeCodesPerSecond = 60
    upAxis = "Z"
)

def Xform "World"
{
    def PhysicsScene "physicsScene" (
        prepend apiSchemas = ["PhysxSceneAPI"]
    )
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
        uniform token physxScene:broadphaseType = "MBP"
        bool physxScene:enableGPUDynamics = 0
        uniform token physxScene:solverType = "TGS"
        uint physxScene:timeStepsPerSecond = 240
    }

    def DistantLight "sun"
    {
        float inputs:intensity = 3000
        float3 xformOp:rotateXYZ = (45, 0, 45)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def DomeLight "sky"
    {
        float inputs:intensity = 500
    }

    # Top face 1 cm below the arm's base so the fixed base never rests on it.
    def Cube "ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.35, 0.35, 0.35)]
        double size = 1
        double3 xformOp:translate = (0, 0, -0.06)
        float3 xformOp:scale = (10, 10, 0.1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Xform "arm" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
    )
    {
        bool physxArticulation:enabledSelfCollisions = 0

        # base: 0.3 x 0.3 x 0.2 m, from z = 0 to 0.2
        def Xform "base" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            float physics:mass = 5
            double3 xformOp:translate = (0, 0, 0.1)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Cube "collision" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                color3f[] primvars:displayColor = [(0.2, 0.2, 0.25)]
                double size = 1
                float3 xformOp:scale = (0.3, 0.3, 0.2)
                uniform token[] xformOpOrder = ["xformOp:scale"]
            }
        }

        # link1: 0.1 x 0.1 x 0.8 m, from z = 0.2 to 1.0
        def Xform "link1" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            float physics:mass = 1
            double3 xformOp:translate = (0, 0, 0.6)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Cube "collision" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                color3f[] primvars:displayColor = [(0.9, 0.5, 0.1)]
                double size = 1
                float3 xformOp:scale = (0.1, 0.1, 0.8)
                uniform token[] xformOpOrder = ["xformOp:scale"]
            }
        }

        # link2: 0.1 x 0.1 x 0.8 m, from z = 1.0 to 1.8
        def Xform "link2" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            float physics:mass = 1
            double3 xformOp:translate = (0, 0, 1.4)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Cube "collision" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                color3f[] primvars:displayColor = [(0.1, 0.5, 0.9)]
                double size = 1
                float3 xformOp:scale = (0.1, 0.1, 0.8)
                uniform token[] xformOpOrder = ["xformOp:scale"]
            }
        }

        # No body0: anchors the base to the world, making the articulation fixed-base.
        def PhysicsFixedJoint "root_joint"
        {
            rel physics:body1 = </World/arm/base>
            point3f physics:localPos0 = (0, 0, 0.1)
            point3f physics:localPos1 = (0, 0, 0)
        }

        def PhysicsRevoluteJoint "joint1" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </World/arm/base>
            rel physics:body1 = </World/arm/link1>
            point3f physics:localPos0 = (0, 0, 0.1)
            point3f physics:localPos1 = (0, 0, -0.4)
            float physics:lowerLimit = -180
            float physics:upperLimit = 180
            float drive:angular:physics:damping = 100
            float drive:angular:physics:maxForce = 1000
            float drive:angular:physics:stiffness = 1000
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
        }

        def PhysicsRevoluteJoint "joint2" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            uniform token physics:axis = "Y"
            rel physics:body0 = </World/arm/link1>
            rel physics:body1 = </World/arm/link2>
            point3f physics:localPos0 = (0, 0, 0.4)
            point3f physics:localPos1 = (0, 0, -0.4)
            float physics:lowerLimit = -120
            float physics:upperLimit = 120
            float drive:angular:physics:damping = 100
            float drive:angular:physics:maxForce = 1000
            float drive:angular:physics:stiffness = 1000
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
        }
    }

    # ROS 2 bridge, ticked once per app update while playing. Publishes the sim
    # clock and the arm's joint states, and applies sensor_msgs/JointState
    # commands from /joint_command to the arm's drives. The ROS domain comes
    # from ROS_DOMAIN_ID.
    def OmniGraph "ROSBridge"
    {
        token evaluationMode = "Automatic"
        token evaluator:type = "execution"
        token fabricCacheBacking = "StageWithoutHistory"
        int2 fileFormatVersion = (1, 9)
        token pipelineStage = "pipelineStageSimulation"

        def OmniGraphNode "OnTick"
        {
            token node:type = "omni.graph.action.OnPlaybackTick"
            int node:typeVersion = 2
            custom uint outputs:tick (
                customData = {
                    bool isExecution = 1
                }
            )
        }

        def OmniGraphNode "Context"
        {
            custom bool inputs:useDomainIDEnvVar = 1
            token node:type = "isaacsim.ros2.bridge.ROS2Context"
            int node:typeVersion = 2
            custom uint64 outputs:context
        }

        def OmniGraphNode "ReadSimTime"
        {
            token node:type = "isaacsim.core.nodes.IsaacReadSimulationTime"
            int node:typeVersion = 1
            custom double outputs:simulationTime
        }

        def OmniGraphNode "PublishClock"
        {
            custom uint64 inputs:context
            prepend uint64 inputs:context.connect = </World/ROSBridge/Context.outputs:context>
            custom uint inputs:execIn (
                customData = {
                    bool isExecution = 1
                }
            )
            prepend uint inputs:execIn.connect = </World/ROSBridge/OnTick.outputs:tick>
            custom double inputs:timeStamp
            prepend double inputs:timeStamp.connect = </World/ROSBridge/ReadSimTime.outputs:simulationTime>
            custom string inputs:topicName = "/clock"
            token node:type = "isaacsim.ros2.bridge.ROS2PublishClock"
            int node:typeVersion = 1
        }

        def OmniGraphNode "ReadJointState"
        {
            custom uint inputs:execIn (
                customData = {
                    bool isExecution = 1
                }
            )
            prepend uint inputs:execIn.connect = </World/ROSBridge/OnTick.outputs:tick>
            custom rel inputs:prim = </World/arm> (
                customData = {
                    dictionary omni = {
                        dictionary graph = {
                            string relType = "target"
                        }
                    }
                }
            )
            token node:type = "isaacsim.sensors.physics.IsaacReadJointState"
            int node:typeVersion = 1
            custom uint outputs:execOut (
                customData = {
                    bool isExecution = 1
                }
            )
            custom uchar[] outputs:jointDofTypes
            custom double[] outputs:jointEfforts
            custom token[] outputs:jointNames
            custom double[] outputs:jointPositions
            custom double[] outputs:jointVelocities
            custom float outputs:sensorTime
            custom float outputs:stageMetersPerUnit
        }

        def OmniGraphNode "PublishJointState"
        {
            custom uint64 inputs:context
            prepend uint64 inputs:context.connect = </World/ROSBridge/Context.outputs:context>
            custom uint inputs:execIn (
                customData = {
                    bool isExecution = 1
                }
            )
            prepend uint inputs:execIn.connect = </World/ROSBridge/ReadJointState.outputs:execOut>
            custom uchar[] inputs:jointDofTypes
            prepend uchar[] inputs:jointDofTypes.connect = </World/ROSBridge/ReadJointState.outputs:jointDofTypes>
            custom double[] inputs:jointEfforts
            prepend double[] inputs:jointEfforts.connect = </World/ROSBridge/ReadJointState.outputs:jointEfforts>
            custom token[] inputs:jointNames
            prepend token[] inputs:jointNames.connect = </World/ROSBridge/ReadJointState.outputs:jointNames>
            custom double[] inputs:jointPositions
            prepend double[] inputs:jointPositions.connect = </World/ROSBridge/ReadJointState.outputs:jointPositions>
            custom double[] inputs:jointVelocities
            prepend double[] inputs:jointVelocities.connect = </World/ROSBridge/ReadJointState.outputs:jointVelocities>
            custom float inputs:sensorTime
            prepend float inputs:sensorTime.connect = </World/ROSBridge/ReadJointState.outputs:sensorTime>
            custom float inputs:stageMetersPerUnit
            prepend float inputs:stageMetersPerUnit.connect = </World/ROSBridge/ReadJointState.outputs:stageMetersPerUnit>
            custom rel inputs:targetPrim (
                customData = {
                    dictionary omni = {
                        dictionary graph = {
                            string relType = "target"
                        }
                    }
                }
            )
            custom string inputs:topicName = "/joint_states"
            token node:type = "isaacsim.ros2.bridge.ROS2PublishJointState"
            int node:typeVersion = 1
        }

        def OmniGraphNode "SubscribeJointCommand"
        {
            custom uint64 inputs:context
            prepend uint64 inputs:context.connect = </World/ROSBridge/Context.outputs:context>
            custom uint inputs:execIn (
                customData = {
                    bool isExecution = 1
                }
            )
            prepend uint inputs:execIn.connect = </World/ROSBridge/OnTick.outputs:tick>
            custom string inputs:topicName = "/joint_command"
            token node:type = "isaacsim.ros2.bridge.ROS2SubscribeJointState"
            int node:typeVersion = 2
            custom double[] outputs:effortCommand
            custom token[] outputs:jointNames
            custom double[] outputs:positionCommand
            custom double[] outputs:velocityCommand
        }

        def OmniGraphNode "ArticulationController"
        {
            custom double[] inputs:effortCommand
            prepend double[] inputs:effortCommand.connect = </World/ROSBridge/SubscribeJointCommand.outputs:effortCommand>
            custom uint inputs:execIn (
                customData = {
                    bool isExecution = 1
                }
            )
            prepend uint inputs:execIn.connect = </World/ROSBridge/OnTick.outputs:tick>
            custom token[] inputs:jointNames
            prepend token[] inputs:jointNames.connect = </World/ROSBridge/SubscribeJointCommand.outputs:jointNames>
            custom double[] inputs:positionCommand
            prepend double[] inputs:positionCommand.connect = </World/ROSBridge/SubscribeJointCommand.outputs:positionCommand>
            custom string inputs:robotPath = "/World/arm"
            custom rel inputs:targetPrim (
                customData = {
                    dictionary omni = {
                        dictionary graph = {
                            string relType = "target"
                        }
                    }
                }
            )
            custom double[] inputs:velocityCommand
            prepend double[] inputs:velocityCommand.connect = </World/ROSBridge/SubscribeJointCommand.outputs:velocityCommand>
            token node:type = "isaacsim.core.nodes.IsaacArticulationController"
            int node:typeVersion = 1
        }
    }
}
