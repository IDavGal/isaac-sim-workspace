# Optional: copy to .env and adjust. One set of values per sim instance on a host
# (docker/sim.sh --env-file FILE picks another file). Every value has a default.

# Also names the container: <project>-sim.
COMPOSE_PROJECT_NAME=isaac-sim

ISAAC_SIM_IMAGE=nvcr.io/nvidia/isaac-sim:6.2.0
SIM_IMAGE=isaac-sim-workspace:6.2.0

# ROS 2 / DDS. DDS_PROFILE picks config/dds/<profile>.xml: loopback when the ROS
# stack runs on this host, network otherwise (set DDS_INTERFACE and DDS_PEER).
ROS_DOMAIN_ID=0
DDS_PROFILE=loopback
DDS_INTERFACE=
DDS_PEER=

# Livestream (docker/sim.sh run --livestream): TCP port the WebRTC client dials,
# UDP media port, advertised address.
LIVESTREAM_SIGNAL_PORT=49100
LIVESTREAM_STREAM_PORT=47998
LIVESTREAM_PUBLIC_IP=

# VS Code / MCP Python executor; 0 disables.
VSCODE_PORT=0

# Default entrypoint arguments, e.g. --stage scenes/other.usda; arguments after
# `docker/sim.sh run --` replace them.
SIM_ARGS=
