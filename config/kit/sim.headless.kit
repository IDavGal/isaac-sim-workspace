[package]
title = "Simulation (headless)"
description = "Isaac Sim without a window or renderer, with the ROS 2 bridge"
version = "0.1.0"
keywords = ["experience", "app", "usd", "isaacsim"]

[dependencies]
"isaacsim.exp.base" = {}
"isaacsim.ros2.bridge" = {}

[settings]
rtx.spg.enabled = true # Enable RTX Sensor Processing Graphs feature

[settings.app]
name = "Simulation"
version = "0.1.0"
settings.persistent = false          # settings reset on each run
vulkan = true
enableDeveloperWarnings = false
renderer.enabled = false             # nothing is displayed, so nothing is rendered

[settings.renderer]
enabled = false

[settings.app.exts.folders]
'++' = [
    "${kit}/../exts",
    "${kit}/../extscache",
    "${kit}/../extsUser",
    "${kit}/../extsDeprecated",
]
