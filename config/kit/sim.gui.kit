[package]
title = "Simulation (GUI)"
description = "The Isaac Sim editor with the ROS 2 bridge, for a local window or a livestream"
version = "0.1.0"
keywords = ["experience", "app", "usd", "isaacsim"]

[dependencies]
"isaacsim.exp.full" = {}
"isaacsim.ros2.bridge" = {}

[settings]
rtx.spg.enabled = true # Enable RTX Sensor Processing Graphs feature

[settings.app]
name = "Simulation"
version = "0.1.0"
settings.persistent = false          # settings reset on each run
vulkan = true
enableDeveloperWarnings = false

[settings.app.exts.folders]
'++' = [
    "${kit}/../exts",
    "${kit}/../extscache",
    "${kit}/../extsUser",
    "${kit}/../extsDeprecated",
]
